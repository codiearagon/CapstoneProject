<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="PointsContainer" style="flex-grow: 0; align-self: flex-end; align-items: flex-start; align-content: auto; justify-content: flex-start; flex-direction: column; flex-shrink: 1; background-color: rgba(0, 0, 0, 0.6); color: rgb(255, 255, 255); width: 10%; font-size: 20px; position: absolute;">
        <ui:Label text="Points: " name="PointsLabel" style="padding-top: 7px; padding-right: 7px; padding-bottom: 7px; padding-left: 7px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="UpgradeContainer" style="flex-grow: 1; position: absolute; width: 25%; height: 50%; align-self: center; align-content: auto; justify-content: flex-start; align-items: stretch; top: 25%; left: 37.5%; background-color: rgba(0, 0, 0, 0.33); color: rgb(255, 255, 255); display: flex; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; font-size: 20px;">
        <ui:VisualElement name="StatsContainer" style="flex-grow: 1; justify-content: space-around; margin-bottom: 10px;"/>
        <ui:Button text="Apply Stats" name="ApplyButton" style="color: rgb(0, 0, 0); font-size: 25px;"/>
    </ui:VisualElement>
</ui:UXML>
