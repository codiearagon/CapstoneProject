:root {
}

.fullscreen-element {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    height: 100%;
    position: absolute;
}

.button-menu {
    font-size: 50px;
    margin-top: 20px;
    margin-right: 0;
    margin-bottom: 20px;
    margin-left: 0;
    background-color: rgb(221, 221, 221);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.button-menu:hover {
    font-size: 50px;
    margin-top: 20px;
    margin-right: 0;
    margin-bottom: 20px;
    margin-left: 0;
    background-color: rgb(248, 248, 248);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.button-menu:active {
    font-size: 50px;
    margin-top: 20px;
    margin-right: 0;
    margin-bottom: 20px;
    margin-left: 0;
    background-color: rgb(173, 173, 173);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.char-icon {
    margin: 10px 10px 10px 10px;
    padding: 10px 10px 10px 10px;
    width: 100px;
    height: 100px;
    border-width: 4px 4px 4px 4px;
    border-color: black;
    background-color: gray;
}

.char-icon:hover {
    background-color: rgb(202, 202, 202);
}

.char-icon:active {
    background-color: rgb(111, 111, 111);
}

#CharScrollView > #unity-content-container {
    align-items: center;
}
