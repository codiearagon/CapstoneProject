<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Background" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.57); position: absolute; width: 100%; height: 100%;"/>
    <ui:VisualElement name="StatsElement" style="flex-grow: 1; color: rgb(255, 255, 255); font-size: 20px; margin-top: 20px; margin-right: 20px; margin-bottom: 20px; margin-left: 20px;">
        <ui:Label text="Label" name="MaxHpLabel"/>
        <ui:Label text="Label" name="MoveSpeedLabel"/>
        <ui:Label text="Label" name="AttackLabel"/>
        <ui:Label text="Label" name="AttackSpeedLabel"/>
        <ui:Label text="Label" name="DefenseLabel"/>
        <ui:Label text="Label" name="HpScalingLabel"/>
        <ui:Label text="Label" name="AttackScalingLabel"/>
        <ui:Label text="Label" name="DefenseScalingLabel"/>
    </ui:VisualElement>
</ui:UXML>
