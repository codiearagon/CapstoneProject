<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/MainMenuUI.uss?fileID=7433441132597879392&amp;guid=14935e5896171d74aa20be19791128a0&amp;type=3#MainMenuUI"/>
    <ui:VisualElement name="MainMenuElement" enabled="true" picking-mode="Ignore" class="fullscreen-element" style="align-items: center; justify-content: flex-start; align-self: auto; align-content: flex-start; display: flex;">
        <ui:VisualElement name="TitleElement" picking-mode="Ignore" style="flex-grow: 1; align-items: center; justify-content: center; flex-shrink: 1;">
            <ui:Label text="Title" name="TitleLabel" style="font-size: 100px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="ButtonsElement" picking-mode="Ignore" style="flex-grow: 0.5; justify-content: flex-start; align-items: stretch; align-self: auto; width: 500px;">
            <ui:Button text="Start&#10;" name="StartButton" class="button-menu"/>
            <ui:Button text="Settings" name="SettingsButton" class="button-menu"/>
            <ui:Button text="Quit" name="QuitButton" class="button-menu"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="CharSelectElement" enabled="true" picking-mode="Ignore" class="fullscreen-element" style="display: none;">
        <ui:VisualElement name="CharSelectedElement" picking-mode="Ignore" style="flex-grow: 1; flex-direction: row;">
            <ui:VisualElement name="CharSplashArtElement" style="flex-grow: 1.5; padding-top: 100px; padding-right: 100px; padding-bottom: 100px; padding-left: 100px; flex-shrink: 0;">
                <ui:Image name="CharSplashArtImage" style="width: 100%; height: 100%;"/>
            </ui:VisualElement>
            <ui:VisualElement name="CharDetailsElement" style="flex-grow: 1; padding-top: 100px; padding-right: 100px; padding-bottom: 100px; padding-left: 100px; flex-shrink: 0;">
                <ui:Label text="Label" name="CharNameLabel" style="font-size: 70px; color: rgb(255, 255, 255); -unity-font-style: bold;"/>
                <ui:Label text="Base Stats:" name="CharStatsTitle" style="font-size: 50px; color: rgb(255, 255, 255); -unity-font-style: normal;"/>
                <ui:Label text="Label" name="CharStatsLabel" style="font-size: 30px; color: rgb(255, 255, 255);"/>
            </ui:VisualElement>
            <ui:Button text="Select Character" name="CharSelectButton" style="flex-shrink: 0; align-self: flex-end; align-items: stretch; justify-content: flex-start; margin-right: 50px; font-size: 20px; -unity-font-style: bold;"/>
        </ui:VisualElement>
        <ui:VisualElement name="CharListElement" picking-mode="Ignore" style="flex-grow: 0; flex-shrink: 1; margin-bottom: 50px; margin-right: 30px; margin-left: 30px; margin-top: 20px;">
            <ui:ScrollView name="CharScrollView" mode="Horizontal" vertical-scroller-visibility="Hidden" style="flex-grow: 1; align-items: center; flex-direction: column; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; align-content: center; justify-content: flex-start; align-self: auto;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
