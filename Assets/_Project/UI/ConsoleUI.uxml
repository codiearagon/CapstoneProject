<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ConsoleElement" style="flex-grow: 0; width: 50%; height: 50%; position: relative; top: auto; left: auto; right: auto; bottom: auto; flex-basis: auto; background-color: rgb(46, 46, 46); padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; border-left-color: rgb(29, 29, 29); border-right-color: rgb(29, 29, 29); border-top-color: rgb(29, 29, 29); border-bottom-color: rgb(29, 29, 29); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; flex-shrink: 0; display: none;">
        <ui:ListView name="LogView" reorderable="false" style="width: 100%; height: 100%; align-items: stretch; background-color: rgba(0, 0, 0, 0); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; flex-grow: 0; flex-shrink: 1; flex-wrap: nowrap; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; flex-direction: column;"/>
        <ui:TextField label="" placeholder-text="enter command" readonly="false" name="CommandField" hide-placeholder-on-focus="false" max-length="50" style="background-color: rgba(96, 96, 96, 0); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;"/>
    </ui:VisualElement>
</ui:UXML>
